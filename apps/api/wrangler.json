{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graflare-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graflare",
      "database_id": "23b0e196-786f-4d3c-ae3a-f394bbd87c8e",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ALERT_RULE",
        "class_name": "AlertRuleDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AlertRuleDO"]
    }
  ],
  "workflows": [
    {
      "name": "notification-workflow",
      "binding": "NOTIFICATION_WORKFLOW",
      "class_name": "NotificationWorkflow"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
