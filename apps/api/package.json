{
  "name": "graflare-api",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts"
    ]
  },
  "scripts": {
    "dev": "localflare wrangler.json --no-open --port 8787 -- --inspector-port 9229",
    "db:migrate:local": "wrangler d1 migrations apply graflare --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "generate": "wrangler types && drizzle-kit generate && pnpm generate:do",
    "generate:do": "drizzle-kit generate --config=drizzle-do.config.ts",
    "clean": "rm -rf dist .wrangler",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.13",
    "@cloudflare/workers-types": "4.20260606.1",
    "@graflare/shared": "workspace:*",
    "@hono/standard-validator": "0.2.2",
    "@types/node": "25.9.2",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3",
    "hono": "4.12.34",
    "vitest": "4.1.8"
  }
}
