{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graflare-web",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "services": [
    {
      "binding": "API",
      "service": "graflare-api",
      "entrypoint": "GraflareAPI"
    }
  ],
  "observability": {
    "enabled": true
  }
}
