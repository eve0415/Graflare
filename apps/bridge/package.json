{
  "name": "graflare-bridge",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts"
    ]
  },
  "scripts": {
    "dev": "localflare wrangler.json --no-open",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "clean": "rm -rf dist .wrangler",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.11",
    "@cloudflare/workers-types": "4.20260602.1",
    "@graflare/shared": "workspace:*",
    "@types/node": "25.9.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "vitest": "4.1.8"
  }
}
