{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graflare-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graflare-bridge",
      "database_id": "b2ea302b-4212-4308-a856-a7622be3a261",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],
  "vars": {
    "CF_ZONE_IDS": "eve0415.net"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
