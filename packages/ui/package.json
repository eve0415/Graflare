{
  "name": "@graflare/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "import": "./src/components/*.tsx",
      "types": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "import": "./src/hooks/*.ts",
      "types": "./src/hooks/*.ts"
    },
    "./lib/*": {
      "import": "./src/lib/*.ts",
      "types": "./src/lib/*.ts"
    },
    "./globals.css": "./src/globals.css"
  },
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "build": "echo 'source-only package'"
  },
  "devDependencies": {
    "@base-ui/react": "1.5.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.1",
    "lucide-react": "1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0"
  }
}
