{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "design@knowledge-work-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Linting and formatting..."
          }
        ]
      }
    ]
  }
}
