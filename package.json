{
  "name": "graflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './apps/*' --filter './packages/*' build",
    "test": "pnpm --filter './apps/*' --filter './packages/*' test",
    "lint": "oxlint --report-unused-disable-directives --fix --fix-suggestions --fix-dangerously && oxfmt",
    "dev": "pnpm --filter './apps/*' dev --parallel",
    "clean": "pnpm --filter './apps/*' --filter './packages/*' clean",
    "generate": "pnpm --filter './apps/*' generate"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260527.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "oxlint-tsgolint": "0.23.0"
  },
  "engines": {
    "node": "24.15.x"
  },
  "packageManager": "pnpm@11.4.0"
}
