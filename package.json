{
  "name": "graflare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter './apps/*' --filter './packages/*' build",
    "test": "pnpm --filter './apps/*' --filter './packages/*' test",
    "check": "tsgo --build",
    "lint": "oxlint .",
    "dev": "pnpm --filter './apps/*' dev --parallel",
    "clean": "pnpm --filter './apps/*' --filter './packages/*' clean",
    "generate": "pnpm --filter './apps/*' generate"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260527.1",
    "oxlint": "1.67.0",
    "oxlint-tsgolint": "0.23.0"
  }
}
